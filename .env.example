# Copiá este archivo como .env (NO lo subas a git) y cargá las mismas variables en Vercel/Netlify.
# Credenciales: andreani.com > Integraciones (tenés que ser cliente Andreani; PyME se registra en andreani.com)
ANDREANI_ENV=qa                 # qa para pruebas, prod para producción
ANDREANI_USUARIO=
ANDREANI_PASSWORD=
ANDREANI_CLIENTE=               # código de cliente
ANDREANI_CONTRATO=              # contrato envío a domicilio
ANDREANI_CONTRATO_SUCURSAL=     # contrato envío a sucursal (si tenés)

# Clave para proteger /api/envios/crear y /api/envios/etiqueta (inventá una larga y aleatoria)
ADMIN_KEY=

# Desde dónde despachás
ORIGEN_CP=
ORIGEN_CALLE=
ORIGEN_NUMERO=
ORIGEN_LOCALIDAD=
ORIGEN_PROVINCIA=
REMITENTE_NOMBRE=High Duo
REMITENTE_EMAIL=
REMITENTE_CUIT=
REMITENTE_TELEFONO=
